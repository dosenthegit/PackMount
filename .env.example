# Copy to .env; use unique passwords; never commit the real file.
PACKMOUNT_USER=admin
PACKMOUNT_PASSWORD=REPLACE_WITH_STRONG_UNIQUE_PASSWORD
PACKMOUNT_SMB_USER=packmount
PACKMOUNT_SMB_PASSWORD=REPLACE_WITH_DIFFERENT_STRONG_PASSWORD
PACKMOUNT_SMB_WORKGROUP=WORKGROUP
PACKMOUNT_SESSION_MAX_AGE=86400
PACKMOUNT_SECURE_COOKIE=false
PACKMOUNT_NFSD_THREADS=8
PACKMOUNT_MOUNTD_PORT=20048

# Optional: used when deploying published images with docker-compose.ghcr.yml
# Docker Hub (default if uncommented):
# PACKMOUNT_IMAGE=d0sn/packmount:latest
# Or GHCR:
# PACKMOUNT_IMAGE=ghcr.io/dosenthegit/packmount:latest
